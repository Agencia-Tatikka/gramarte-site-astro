---
import type { Produto } from '@/types';
import CatalogCard from './CatalogCard.astro';

interface Props {
  produtos: Produto[];
  title?: string;
  subtitle?: string;
  showFilters?: boolean;
}

const {
  produtos,
  title = "Vitrine de Destaques & Soluções",
  subtitle = "Explore nossas principais soluções desenvolvidas sob medida para acelerar resultados.",
  showFilters = true
} = Astro.props;

// Categorias únicas
const categorias = ['Todos', ...Array.from(new Set(produtos.map(p => p.categoria)))];
---

<section class="py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header da Seção -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-white tracking-tight">
        {title}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-400">
        {subtitle}
      </p>

      <!-- Filtros de Categoria (Interativo no Cliente) -->
      {showFilters && categorias.length > 2 && (
        <div class="mt-8 flex flex-wrap items-center justify-center gap-2" id="catalog-filter-container">
          {categorias.map((cat, idx) => (
            <button
              type="button"
              data-category={cat}
              class={`catalog-filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all duration-200 border ${
                idx === 0
                  ? 'bg-indigo-600 text-white border-indigo-500 shadow-md shadow-indigo-500/20'
                  : 'bg-slate-900/80 text-slate-400 border-slate-800 hover:text-white hover:border-slate-700'
              }`}
            >
              {cat}
            </button>
          ))}
        </div>
      )}
    </div>

    <!-- Grade de Produtos -->
    {produtos.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="catalog-items-grid">
        {produtos.map(prod => (
          <div class="catalog-item-wrapper" data-category={prod.categoria}>
            <CatalogCard produto={prod} />
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-slate-900/30 rounded-3xl border border-slate-800">
        <p class="text-slate-400 text-base">Nenhum item cadastrado no momento.</p>
      </div>
    )}
  </div>
</section>

<script>
  // Filtro dinâmico no cliente sem reload de página
  const buttons = document.querySelectorAll<HTMLButtonElement>('.catalog-filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.catalog-item-wrapper');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-category');

      // Atualiza botões
      buttons.forEach(b => {
        b.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-500', 'shadow-md', 'shadow-indigo-500/20');
        b.classList.add('bg-slate-900/80', 'text-slate-400', 'border-slate-800');
      });
      btn.classList.remove('bg-slate-900/80', 'text-slate-400', 'border-slate-800');
      btn.classList.add('bg-indigo-600', 'text-white', 'border-indigo-500', 'shadow-md', 'shadow-indigo-500/20');

      // Filtra itens
      items.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        if (selected === 'Todos' || itemCat === selected) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>
