---
import Button from '@/components/ui/Button.astro';
import { siteConfig } from '@/config/site.config';

const whatsappUrl = `https://wa.me/${siteConfig.contact.whatsapp}?text=${encodeURIComponent(siteConfig.contact.whatsappMessage || '')}`;
---

<section class="relative pt-24 pb-20 md:pt-36 md:pb-32 overflow-hidden">
  <!-- Background Glow / Ambient Lights -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-indigo-600/20 blur-[120px] rounded-full pointer-events-none"></div>
  <div class="absolute top-1/3 right-10 w-[300px] h-[300px] bg-amber-500/10 blur-[100px] rounded-full pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <!-- Tagline Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-950/80 border border-indigo-500/30 text-indigo-300 text-xs font-semibold mb-8 backdrop-blur-md">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      Alta Performance & Conversão
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold font-display tracking-tight text-white leading-[1.1] mb-8">
      Transforme visitantes em clientes com <span class="gradient-text">velocidade recorde</span>.
    </h1>

    <!-- Subheadline -->
    <p class="text-lg sm:text-xl text-slate-400 max-w-3xl mx-auto mb-10 leading-relaxed font-normal">
      Estrutura moderna, design refinado e rastreamento avançado de conversão prontos para acelerar o faturamento da sua empresa no digital.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href={whatsappUrl} variant="primary" size="lg" target="_blank">
        Quero um Diagnóstico Gratuito ➔
      </Button>
      <Button href="#servicos" variant="secondary" size="lg">
        Conhecer Nossos Serviços
      </Button>
    </div>

    <!-- Métricas / Prova Rápida -->
    <div class="mt-16 pt-10 border-t border-slate-800/80 grid grid-cols-2 md:grid-cols-4 gap-8">
      <div>
        <span class="block text-3xl font-extrabold font-display text-white">99/100</span>
        <span class="text-xs text-slate-400 uppercase tracking-wider font-semibold">PageSpeed Score</span>
      </div>
      <div>
        <span class="block text-3xl font-extrabold font-display text-indigo-400">+100k</span>
        <span class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Leads Gerados</span>
      </div>
      <div>
        <span class="block text-3xl font-extrabold font-display text-amber-400">&lt; 0.8s</span>
        <span class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Tempo de Carga</span>
      </div>
      <div>
        <span class="block text-3xl font-extrabold font-display text-emerald-400">100%</span>
        <span class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Foco em Vendas</span>
      </div>
    </div>
  </div>
</section>
