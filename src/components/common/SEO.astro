---
import { siteConfig } from '@/config/site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: string;
}

const {
  title = `${siteConfig.name} • ${siteConfig.tagline}`,
  description = siteConfig.description,
  image = `${siteConfig.url}/og-default.jpg`,
  canonical = Astro.url.href,
  type = 'website'
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LandscapeService",
      "@id": "https://gramarte.com.br/#localbusiness",
      "name": "Gramarte Paisagismo & Manutenção de Jardins",
      "url": "https://gramarte.com.br",
      "telephone": "+55-11-94046-6849",
      "email": "contato@gramarte.com.br",
      "image": "https://gramarte.com.br/gramarte-logo-2026.jpg",
      "logo": "https://gramarte.com.br/gramarte-logo-2026.jpg",
      "description": "Especialistas em paisagismo, implantação, poda e manutenção preventiva de áreas verdes para condomínios residenciais e comerciais.",
      "taxID": "54.094.244/0001-00",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "São Bernardo do Campo",
        "addressRegion": "SP",
        "addressCountry": "BR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -23.6944,
        "longitude": -46.5654
      },
      "areaServed": [
        { "@type": "City", "name": "São Paulo" },
        { "@type": "City", "name": "Santo André" },
        { "@type": "City", "name": "São Bernardo do Campo" },
        { "@type": "City", "name": "São Caetano do Sul" },
        { "@type": "City", "name": "Barueri" },
        { "@type": "City", "name": "Santana de Parnaíba" },
        { "@type": "City", "name": "Cotia" },
        { "@type": "AdministrativeArea", "name": "Grande ABC" },
        { "@type": "AdministrativeArea", "name": "Litoral de São Paulo" },
        { "@type": "AdministrativeArea", "name": "Interior de São Paulo" }
      ],
      "sameAs": [
        "https://instagram.com/gramarte.jardinagem"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://gramarte.com.br/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Como funciona a solicitação de orçamento e avaliação técnica?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Você entra em contato conosco pelo WhatsApp ou e-mail, informa os dados do condomínio e alinhamos uma avaliação técnica presencial para analisar a área verde e apresentar uma proposta personalizada sob medida."
          }
        },
        {
          "@type": "Question",
          "name": "Quais serviços estão contemplados na manutenção contínua de jardins?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nossos contratos de manutenção cuidam de toda a rotina do jardim: cortes periódicos de grama, podas de conformação e limpeza botânica, controle preventivo de pragas e cuidados minuciosos para manter as áreas verdes sempre exuberantes e valorizadas."
          }
        },
        {
          "@type": "Question",
          "name": "Qual é a frequência de atendimento e visitas da equipe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Montamos um cronograma fixo semanal ou quinzenal alinhado com o síndico e a zeladoria, garantindo pontualidade rigorosa e atendimento ágil para manutenções programadas."
          }
        },
        {
          "@type": "Question",
          "name": "Quais regiões são atendidas pela Gramarte?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Atendemos condomínios residenciais e comerciais em São Paulo (Capital), Grande ABC (Santo André, São Bernardo, São Caetano), Alphaville, Cotia, Litoral e Interior de SP."
          }
        },
        {
          "@type": "Question",
          "name": "Como é feito o descarte dos resíduos de podas e cortes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Todo o descarte verde é ensacado e destinado de forma ambientalmente correta a ecopontos e caçambas credenciadas, mantendo o condomínio totalmente limpo após cada serviço."
          }
        }
      ]
    }
  ]
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/png" href="/gramarte-favicon.png" />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Geo Local Meta Tags -->
<meta name="geo.region" content="BR-SP" />
<meta name="geo.placename" content="São Paulo, Grande ABC" />
<meta name="geo.position" content="-23.6944;-46.5654" />
<meta name="ICBM" content="-23.6944, -46.5654" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:site_name" content={siteConfig.name} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonical} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />

<!-- JSON-LD Structured Data (LocalBusiness + FAQPage) -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<!-- Google Fonts Preconnect -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
