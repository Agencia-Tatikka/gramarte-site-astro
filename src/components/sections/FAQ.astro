---
const faqs = [
  {
    question: "Quanto tempo leva para criar uma Landing Page ou Site?",
    answer: "Graças à arquitetura do nosso template Astro modular, entregamos landing pages completas em até 5 a 7 dias úteis e sites institucionais em até 15 dias."
  },
  {
    question: "O site já vem otimizado para o Google (SEO)?",
    answer: "Sim! Todos os projetos já incluem meta tags OpenGraph, sitemap XML, microdados Schema.org e carregamento ultra-rápido para ranqueamento."
  },
  {
    question: "Como funciona a hospedagem e manutenção?",
    answer: "Publicamos em infraestruturas globais de alta velocidade (como Cloudflare Pages e Vercel) com SSL gratuito e custo de servidor extremamente baixo ou nulo."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<!-- JSON-LD Structured Data for Google Rich Snippets -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section id="faq" class="py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-xs uppercase font-bold tracking-widest text-indigo-400 mb-3">Tire Suas Dúvidas</h2>
      <h3 class="text-3xl sm:text-4xl font-extrabold font-display text-white tracking-tight">
        Perguntas Frequentes
      </h3>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, idx) => (
        <details class="group p-6 rounded-2xl bg-slate-900/60 border border-slate-800 transition-colors hover:border-slate-700">
          <summary class="flex justify-between items-center cursor-pointer font-semibold text-white text-base">
            <span>{faq.question}</span>
            <span class="text-indigo-400 transition-transform group-open:rotate-180">
              ▼
            </span>
          </summary>
          <p class="mt-4 text-sm text-slate-400 leading-relaxed">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
