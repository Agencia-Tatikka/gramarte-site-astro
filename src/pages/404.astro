---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout title="Página Não Encontrada (404)">
  <section class="min-h-[70vh] flex items-center justify-center px-4 text-center">
    <div>
      <span class="text-7xl font-extrabold font-display gradient-text block mb-4">404</span>
      <h1 class="text-2xl font-bold text-white mb-4">Página Não Encontrada</h1>
      <p class="text-sm text-slate-400 max-w-sm mx-auto mb-8">
        O link que você tentou acessar não existe ou foi movido.
      </p>
      <Button href="/" variant="primary" size="md">
        Voltar à Página Principal
      </Button>
    </div>
  </section>
</BaseLayout>
