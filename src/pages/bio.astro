---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site.config';

const servicos = [
  {
    titulo: "Paisagismo e Harmonização Botânica",
    icone: "🌱",
    msg: "Olá! Vim pelo link da bio da Gramarte e gostaria de solicitar um orçamento para Paisagismo no meu condomínio."
  },
  {
    titulo: "Manutenção Contínua de Jardins",
    icone: "✂️",
    msg: "Olá! Vim pelo link da bio da Gramarte e gostaria de solicitar um orçamento para Manutenção Mensal de Jardim."
  },
  {
    titulo: "Implantação de Novos Jardins",
    icone: "🏡",
    msg: "Olá! Vim pelo link da bio da Gramarte e gostaria de solicitar um orçamento para Implantação de Jardim."
  },
  {
    titulo: "Jardim Vertical e Muros Verdes",
    icone: "🌿",
    msg: "Olá! Vim pelo link da bio da Gramarte e gostaria de solicitar um orçamento para Jardim Vertical."
  },
  {
    titulo: "Corte de Grama e Podas Periódicas",
    icone: "🚜",
    msg: "Olá! Vim pelo link da bio da Gramarte e gostaria de solicitar um orçamento para Corte e Poda de Gramado."
  },
  {
    titulo: "Revitalização de Canteiros",
    icone: "✨",
    msg: "Olá! Vim pelo link da bio da Gramarte e gostaria de solicitar um orçamento para Revitalização de Jardim."
  },
  {
    titulo: "Projetos Personalizados (3D / Irrigação)",
    icone: "📐",
    msg: "Olá! Vim pelo link da bio da Gramarte e gostaria de solicitar um projeto personalizado para meu condomínio."
  }
];

const whatsappBioMsg = encodeURIComponent("Olá! Vim pelo Instagram da Gramarte e gostaria de solicitar uma avaliação técnica para o meu condomínio.");
const whatsappUrl = `https://wa.me/${siteConfig.contact.whatsapp}?text=${whatsappBioMsg}`;
const mapsUrl = `https://maps.google.com/?q=${encodeURIComponent(siteConfig.contact.address)}`;
const instagramUrl = siteConfig.socials.instagram || "https://instagram.com/gramarte.jardinagem";
---

<BaseLayout 
  title="Gramarte • Contato e Serviços (Link da Bio)"
  description="Fale com a equipe da Gramarte Paisagismo e Jardinagem pelo WhatsApp, conheça nossos serviços especializados para condomínios e veja nossa localização."
  hideHeader={true}
  hideFooter={true}
  hideWhatsApp={true}
  hideCookieBanner={true}
  bodyClass="bg-[#FDFDFD] text-stone-900 selection:bg-emerald-100 selection:text-emerald-900"
>
  <div class="min-h-screen flex flex-col items-center justify-between px-4 py-8 max-w-md mx-auto font-sans">
    
    <!-- Profile Header -->
    <header class="w-full flex flex-col items-center text-center">
      <a href="/" class="transition-transform duration-300 hover:scale-105 active:scale-95" title="Gramarte Paisagismo">
        <picture>
          <source srcset="/gramarte-logo-2026.webp" type="image/webp" />
          <img 
            src="/gramarte-logo-2026.jpg" 
            alt="Gramarte Paisagismo" 
            width="130"
            height="85"
            class="w-32 max-w-[130px] h-auto object-contain mx-auto"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      </a>

      <h1 class="mt-4 text-xl font-extrabold text-stone-900 tracking-tight">
        Gramarte Paisagismo
      </h1>
      
      <p class="mt-1 text-xs sm:text-sm text-stone-600 font-medium">
        Paisagismo e Jardinagem Especializada para Condomínios
      </p>

      <!-- Localização / Endereço com Link para Google Maps (Oculto temporariamente)
      <a 
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-stone-100 hover:bg-stone-200/80 text-stone-700 border border-stone-300/80 transition-all duration-200 group shadow-2xs text-left"
        title="Ver localização no Google Maps"
      >
        <svg class="w-4 h-4 text-emerald-700 shrink-0 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span class="truncate max-w-[280px]">Rua Eliza da Silva Frezolone, 370 - SBC</span>
      </a>
      -->
    </header>

    <!-- Main Link Blocks -->
    <main class="w-full flex-grow flex flex-col gap-3.5 mt-6">
      
      <!-- Primary WhatsApp Button (Destaque Pulsante) -->
      <a 
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full relative flex items-center justify-between px-5 py-4 rounded-2xl bg-emerald-700 hover:bg-emerald-800 active:scale-[0.98] text-white font-bold shadow-lg shadow-emerald-800/25 hover:shadow-emerald-800/35 transition-all duration-200 group"
      >
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-white/20 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </div>
          <div class="text-left">
            <span class="block text-sm leading-tight">Falar no WhatsApp</span>
            <span class="block text-[11px] text-emerald-100 font-normal">Solicitar Avaliação Técnica e Proposta</span>
          </div>
        </div>
        <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <!-- Secondary Actions: Instagram e Email -->
      <div class="grid grid-cols-2 gap-2.5">
        <a 
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 p-3 rounded-xl bg-white border border-stone-300 hover:border-emerald-600 active:scale-[0.98] text-xs font-semibold text-stone-800 shadow-2xs transition-all"
        >
          <svg class="w-4 h-4 text-emerald-700 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>Instagram</span>
        </a>

        <a 
          href={`mailto:${siteConfig.contact.email}`}
          class="flex items-center justify-center gap-2 p-3 rounded-xl bg-white border border-stone-300 hover:border-emerald-600 active:scale-[0.98] text-xs font-semibold text-stone-800 shadow-2xs transition-all"
        >
          <svg class="w-4 h-4 text-stone-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>E-mail</span>
        </a>
      </div>

      <!-- Divider / Label Serviços -->
      <div class="pt-4 pb-1 text-left">
        <p class="text-xs uppercase font-bold tracking-wider text-emerald-800">
          Nossos Serviços no WhatsApp
        </p>
      </div>

      <!-- List of Services Linked to WhatsApp -->
      <div class="flex flex-col gap-2">
        {servicos.map((servico) => {
          const cardUrl = `https://wa.me/${siteConfig.contact.whatsapp}?text=${encodeURIComponent(servico.msg)}`;
          return (
            <a 
              href={cardUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-3.5 rounded-xl bg-white border border-stone-200/90 hover:border-emerald-600 hover:shadow-xs active:scale-[0.99] transition-all group"
            >
              <div class="flex items-center gap-3">
                <span class="text-xl shrink-0">{servico.icone}</span>
                <span class="text-xs sm:text-sm font-semibold text-stone-800 group-hover:text-emerald-800 transition-colors text-left leading-tight">
                  {servico.titulo}
                </span>
              </div>
              <svg class="w-4 h-4 text-stone-400 group-hover:text-emerald-700 group-hover:translate-x-0.5 transition-all shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          );
        })}
      </div>

    </main>

    <!-- Footer -->
    <footer class="w-full mt-10 pt-6 border-t border-stone-200 text-center text-xs text-stone-500 flex flex-col items-center gap-2">
      <a 
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-800 hover:text-emerald-900 transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Acessar site completo da Gramarte</span>
      </a>
      <p>© {new Date().getFullYear()} Gramarte • CNPJ 54.094.244/0001-00</p>
    </footer>

  </div>
</BaseLayout>
