---
import Button from '@/components/ui/Button.astro';
import { siteConfig } from '@/config/site.config';

const webhookUrl = siteConfig.contact.webhookUrl || '';
---

<section id="contato" class="py-24 relative overflow-hidden">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-xs uppercase font-bold tracking-widest text-indigo-400 mb-3">Vamos Conversar</h2>
      <h3 class="text-3xl sm:text-4xl font-extrabold font-display text-white tracking-tight">
        Pronto para Acelerar seus Resultados no Digital?
      </h3>
      <p class="mt-4 text-base text-slate-400">
        Preencha o formulário abaixo e nossa equipe técnica entrará em contato em menos de 2 horas úteis.
      </p>
    </div>

    <div class="p-8 sm:p-12 rounded-3xl bg-slate-900/80 border border-slate-800 shadow-2xl backdrop-blur-md">
      <form id="lead-contact-form" class="space-y-6" data-webhook={webhookUrl}>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              Seu Nome Completo *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Ex: Carlos Silva"
              class="w-full px-4 py-3.5 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 text-sm transition-all"
            />
          </div>

          <div>
            <label for="whatsapp" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              WhatsApp com DDD *
            </label>
            <input
              type="tel"
              id="whatsapp"
              name="whatsapp"
              required
              placeholder="Ex: (11) 99999-9999"
              class="w-full px-4 py-3.5 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 text-sm transition-all"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              E-mail Corporativo *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="Ex: carlos@empresa.com.br"
              class="w-full px-4 py-3.5 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 text-sm transition-all"
            />
          </div>

          <div>
            <label for="company" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              Nome da Empresa / Segmento
            </label>
            <input
              type="text"
              id="company"
              name="company"
              placeholder="Ex: Escritório de Advocacia"
              class="w-full px-4 py-3.5 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 text-sm transition-all"
            />
          </div>
        </div>

        <div>
          <label for="message" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Como podemos ajudar sua empresa? (Opcional)
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder="Conte um pouco sobre o projeto ou objetivo atual..."
            class="w-full px-4 py-3.5 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 text-sm transition-all resize-none"
          ></textarea>
        </div>

        <div id="form-feedback" class="hidden text-sm p-4 rounded-xl"></div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full py-4 px-8 rounded-xl font-bold font-display text-white bg-gradient-to-r from-indigo-600 via-indigo-500 to-amber-500 hover:opacity-95 shadow-lg shadow-indigo-500/20 hover:scale-[1.01] active:scale-[0.99] transition-all cursor-pointer text-base flex items-center justify-center gap-2"
        >
          <span>Solicitar Diagnóstico Gratuito ➔</span>
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('lead-contact-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const webhookUrl = form.getAttribute('data-webhook');

      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        whatsapp: formData.get('whatsapp'),
        email: formData.get('email'),
        company: formData.get('company'),
        message: formData.get('message'),
        submitted_at: new Date().toISOString(),
        page_url: window.location.href
      };

      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.innerHTML = '<span>Enviando informações... ⏳</span>';
      }

      // Disparar evento no Meta Pixel e Google Analytics se disponíveis
      if (typeof window !== 'undefined') {
        if ((window as any).fbq) {
          (window as any).fbq('track', 'Lead', { content_name: 'Formulário de Contato' });
        }
        if ((window as any).gtag) {
          (window as any).gtag('event', 'generate_lead', { event_category: 'form', event_label: 'Lead' });
        }
      }

      try {
        // 1. Enviar para a API interna (/api/leads) -> Turso + Brevo
        await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: payload.name,
            whatsapp: payload.whatsapp,
            email: payload.email,
            company: payload.company,
            message: payload.message,
            pageUrl: payload.page_url
          })
        });

        // 2. Enviar para webhook externo (N8N / CRM) se configurado
        if (webhookUrl && webhookUrl.startsWith('http')) {
          await fetch(webhookUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        }
        // Redirecionar para página de agradecimento
        window.location.href = '/obrigado';
      } catch (err) {
        if (feedback) {
          feedback.className = 'text-sm p-4 rounded-xl bg-amber-950/60 border border-amber-500/40 text-amber-200 block';
          feedback.textContent = 'Mensagem registrada! Redirecionando...';
        }
        setTimeout(() => {
          window.location.href = '/obrigado';
        }, 1200);
      }
    });
  }
</script>
