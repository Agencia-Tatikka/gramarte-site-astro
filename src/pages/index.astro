---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site.config';

const servicos = [
  {
    titulo: "Paisagismo",
    descricao: "Concepção estética e harmonização botânica de áreas externas e internas para valorizar o patrimônio condominial.",
    icone: "🌱",
    msg: "Olá! Visitei o site da Gramarte e gostaria de solicitar um orçamento para Paisagismo no meu condomínio."
  },
  {
    titulo: "Manutenção de Jardim",
    descricao: "Cronograma preventivo e corretivo contínuo, adubação de solo, controle biológico de pragas e nutrição vegetal.",
    icone: "✂️",
    msg: "Olá! Visitei o site da Gramarte e gostaria de solicitar um orçamento para Manutenção Mensal de Jardim."
  },
  {
    titulo: "Implantação de Jardim",
    descricao: "Execução técnica de novos canteiros, preparo minucioso de terra vegetal, drenagem e plantio de espécies selecionadas.",
    icone: "🏡",
    msg: "Olá! Visitei o site da Gramarte e gostaria de solicitar um orçamento para Implantação de Jardim."
  },
  {
    titulo: "Jardim Vertical",
    descricao: "Painéis e muros verdes com sistemas inteligentes de irrigação automatizada, ideais para halls, fachadas e áreas de lazer.",
    icone: "🌿",
    msg: "Olá! Visitei o site da Gramarte e gostaria de solicitar um orçamento para Jardim Vertical."
  },
  {
    titulo: "Corte de Grama",
    descricao: "Aparação periódica com maquinário profissional e seguro, refilamento de bordas, descarte ecológico e limpeza impecável.",
    icone: "🚜",
    msg: "Olá! Visitei o site da Gramarte e gostaria de solicitar um orçamento para Corte e Poda de Gramado."
  },
  {
    titulo: "Revitalização de Jardim",
    descricao: "Recuperação profunda de gramados degradados, aeração de solo compacto e substituição estratégica de folhagens.",
    icone: "✨",
    msg: "Olá! Visitei o site da Gramarte e gostaria de solicitar um orçamento para Revitalização de Canteiros."
  },
  {
    titulo: "Projetos Personalizados",
    descricao: "Soluções sob medida para condomínios residenciais e corporativos, com estudos de insolação, irrigação e iluminação cênica.",
    icone: "📐",
    msg: "Olá! Visitei o site da Gramarte e gostaria de solicitar um projeto personalizado (3D / Irrigação / Iluminação)."
  }
];

const faqs = [
  {
    pergunta: "Como funciona a solicitação de orçamento e avaliação técnica?",
    resposta: "Você entra em contato conosco pelo WhatsApp ou e-mail, informa os dados do condomínio e alinhamos uma avaliação técnica presencial para analisar a área verde e apresentar uma proposta personalizada sob medida."
  },
  {
    pergunta: "Quais serviços estão contemplados na manutenção contínua de jardins?",
    resposta: "Nossos contratos de manutenção cuidam de toda a rotina do jardim: cortes periódicos de grama, podas de conformação e limpeza botânica, controle preventivo de pragas e cuidados minuciosos para manter as áreas verdes sempre exuberantes e valorizadas."
  },
  {
    pergunta: "Qual é a frequência de atendimento e visitas da equipe?",
    resposta: "Montamos um cronograma fixo semanal ou quinzenal alinhado com o síndico e a zeladoria, garantindo pontualidade rigorosa e atendimento ágil para manutenções programadas."
  },
  {
    pergunta: "Quais regiões são atendidas pela Gramarte?",
    resposta: "Atendemos condomínios residenciais e comerciais em São Paulo (Capital), Grande ABC (Santo André, São Bernardo, São Caetano), Alphaville, Cotia, Litoral e Interior de SP."
  },
  {
    pergunta: "Como é feito o descarte dos resíduos de podas e cortes?",
    resposta: "Todo o descarte verde é ensacado e destinado de forma ambientalmente correta a ecopontos e caçambas credenciadas, mantendo o condomínio totalmente limpo após cada serviço."
  }
];

const whatsappMainMsg = encodeURIComponent("Olá! Visitei o site da Gramarte e gostaria de solicitar um orçamento para meu condomínio.");
const whatsappUrl = `https://wa.me/${siteConfig.contact.whatsapp}?text=${whatsappMainMsg}`;
const instagramUrl = siteConfig.socials.instagram || "https://instagram.com/gramarte.jardinagem";
---

<BaseLayout 
  title="Gramarte • Paisagismo & Manutenção de Jardins para Condomínios"
  description="Estamos cultivando nossa nova experiência digital. Atendimento, manutenção de áreas verdes e revitalização de jardins para condomínios já disponíveis em São Paulo, Grande ABC, Litoral e Interior."
  hideHeader={true}
  hideFooter={true}
  hideWhatsApp={true}
  hideCookieBanner={true}
  bodyClass="bg-[#FDFDFD] text-stone-900 selection:bg-emerald-100 selection:text-emerald-900"
>
  <div class="min-h-screen flex flex-col justify-between relative overflow-hidden font-sans">
    
    <!-- Top Header Limpo & Centralizado -->
    <header class="w-full pt-8 pb-4 px-4 sm:px-8 max-w-7xl mx-auto flex items-center justify-center border-b border-stone-200/80">
      <picture>
        <source srcset="/gramarte-logo-2026.webp" type="image/webp" />
        <img 
          src="/gramarte-logo-2026.jpg" 
          alt="Gramarte Paisagismo" 
          width="130"
          height="85"
          class="w-32 sm:w-36 max-w-[130px] h-auto object-contain transition-transform duration-300 hover:scale-[1.03]"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </header>

    <!-- Main Content -->
    <main class="flex-grow flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8 py-10 max-w-5xl mx-auto text-center w-full">
      
      <!-- Tag / Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-stone-100 text-stone-800 border border-stone-300 mb-6 shadow-2xs">
        <span class="text-emerald-700 font-bold" aria-hidden="true">●</span>
        <span>Novo Site em Construção</span>
      </div>

      <!-- Headline com 'áreas verdes' e 'espaços vivos' destacados -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-stone-900 tracking-tight leading-[1.15] max-w-4xl">
        Transformamos <span class="text-emerald-800">áreas verdes</span> em <span class="text-emerald-800">espaços vivos</span> e valorizados.
      </h1>

      <!-- Description Refinada em 2 linhas -->
      <p class="mt-4 text-sm sm:text-base text-stone-700 max-w-2xl leading-relaxed">
        Estamos cultivando nossa nova experiência digital. O atendimento, a manutenção e a revitalização de jardins para condomínios já estão disponíveis.
      </p>

      <!-- Action Buttons Calibrados -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
        <a 
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl text-base font-bold text-white bg-emerald-700 hover:bg-emerald-800 active:scale-[0.98] shadow-lg shadow-emerald-800/25 hover:shadow-emerald-800/35 transition-all duration-200 group"
        >
          <svg class="w-6 h-6 fill-current shrink-0 transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564c.173.087.289.129.332.202.043.073.043.419-.101.824z"/>
          </svg>
          <span>Fale no WhatsApp</span>
        </a>

        <a 
          href={`mailto:${siteConfig.contact.email}`}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-base font-semibold text-stone-800 bg-white hover:bg-stone-50 border border-stone-300 hover:border-stone-400 active:scale-[0.98] shadow-2xs transition-all duration-200"
        >
          <svg class="w-5 h-5 text-stone-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>{siteConfig.contact.email}</span>
        </a>
      </div>

      <!-- Showcase Image com Zero CLS e WebP -->
      <div class="mt-12 w-full max-w-4xl rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl border border-stone-200/80 bg-stone-100 group relative">
        <picture>
          <source srcset="/jardim-hero.webp" type="image/webp" />
          <img 
            src="/jardim-hero.jpg" 
            alt="Jardim exuberante e sustentável Gramarte" 
            width="1100"
            height="821"
            class="w-full h-64 sm:h-80 md:h-[420px] object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent flex items-end p-6 sm:p-8">
          <div class="text-left text-white max-w-xl backdrop-blur-md bg-emerald-950/50 p-4 sm:p-5 rounded-2xl border border-white/20">
            <p class="text-xs uppercase tracking-wider text-emerald-300 font-bold mb-1">Qualidade & Sustentabilidade</p>
            <p class="text-sm sm:text-base text-stone-100 font-medium leading-relaxed">
              Cuidado minucioso em cada detalhe botânico para valorizar o seu condomínio com saúde vegetal e beleza duradoura.
            </p>
          </div>
        </div>
      </div>

      <!-- Services Grid (7 Cards Interativos) -->
      <div class="mt-16 w-full text-left">
        <div class="text-center mb-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-stone-900">Especialidades & Soluções</h2>
          <p class="mt-2 text-sm sm:text-base text-stone-700">Clique em qualquer serviço para conversar diretamente com nossa equipe no WhatsApp:</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {servicos.map((servico, index) => {
            const cardWaUrl = `https://wa.me/${siteConfig.contact.whatsapp}?text=${encodeURIComponent(servico.msg)}`;
            return (
              <a 
                href={cardWaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  "p-6 rounded-2xl bg-white border border-stone-200/80 shadow-2xs transition-all duration-300 flex flex-col justify-between group hover:border-emerald-600 hover:shadow-md hover:-translate-y-1 relative cursor-pointer",
                  index === 6 && "sm:col-span-2 lg:col-span-1"
                ]}
              >
                <div>
                  <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-900 flex items-center justify-center text-2xl mb-4 border border-emerald-200 group-hover:bg-emerald-700 group-hover:text-white transition-colors duration-300 shadow-2xs">
                    {servico.icone}
                  </div>
                  <h3 class="text-lg font-bold text-stone-900 group-hover:text-emerald-800 transition-colors">
                    {servico.titulo}
                  </h3>
                  <p class="mt-2 text-sm text-stone-700 leading-relaxed">
                    {servico.descricao}
                  </p>
                </div>
                
                <div class="mt-4 pt-3 border-t border-stone-100 flex items-center justify-between text-xs font-bold text-emerald-800 group-hover:text-emerald-900">
                  <span>Solicitar Orçamento</span>
                  <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </div>
              </a>
            );
          })}
        </div>
      </div>

      <!-- FAQ Section (5 Itens Estratégicos) -->
      <section class="mt-20 w-full text-left max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-2xl sm:text-3xl font-bold text-stone-900">Dúvidas Frequentes</h2>
          <p class="mt-2 text-sm sm:text-base text-stone-700">Tudo o que você precisa saber sobre nosso atendimento e manutenção:</p>
        </div>

        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group bg-white rounded-2xl border border-stone-200/90 shadow-2xs overflow-hidden transition-all duration-200 open:border-emerald-600/60 open:shadow-xs">
              <summary class="flex items-center justify-between p-5 sm:p-6 cursor-pointer font-bold text-stone-900 group-hover:text-emerald-800 transition-colors list-none select-none text-base sm:text-lg">
                <span>{faq.pergunta}</span>
                <span class="ml-4 w-7 h-7 rounded-full bg-stone-100 group-hover:bg-emerald-50 text-stone-500 group-hover:text-emerald-700 flex items-center justify-center transition-all duration-300 group-open:rotate-180 shrink-0">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="px-5 sm:px-6 pb-6 text-sm sm:text-base text-stone-700 leading-relaxed border-t border-stone-100 pt-4">
                {faq.resposta}
              </div>
            </details>
          ))}
        </div>
      </section>

    </main>

    <!-- Floating WhatsApp Button -->
    <aside class="fixed bottom-6 right-6 z-50 flex items-center group">
      <a 
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Fale Conosco no WhatsApp"
        class="flex items-center justify-center w-14 h-14 bg-emerald-700 hover:bg-emerald-600 text-white rounded-full shadow-2xl shadow-emerald-900/40 transition-all duration-300 hover:scale-110 active:scale-95 focus:outline-none focus:ring-4 focus:ring-emerald-300 relative"
      >
        <span class="absolute inset-0 rounded-full bg-emerald-600 animate-ping opacity-25"></span>
        <svg class="w-7 h-7 fill-current relative z-10" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
      </a>
    </aside>

    <!-- Footer Simples, Limpo e Acessível (WCAG AA) -->
    <footer class="w-full py-8 px-4 border-t border-stone-200/80 text-center text-xs text-stone-600">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>© {new Date().getFullYear()} {siteConfig.name} — CNPJ 54.094.244/0001-00. Todos os direitos reservados.</p>
        <div class="flex items-center gap-4 text-stone-700 font-medium">
          <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-800 transition-colors">Instagram</a>
          <span aria-hidden="true">•</span>
          <a href={`mailto:${siteConfig.contact.email}`} class="hover:text-emerald-800 transition-colors">{siteConfig.contact.email}</a>
        </div>
      </div>
    </footer>

  </div>
</BaseLayout>
