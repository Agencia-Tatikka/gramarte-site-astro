---
import type { Produto } from '@/types';
import { siteConfig } from '@/config/site.config';
import Button from '@/components/ui/Button.astro';

interface Props {
  produto: Produto;
}

const { produto } = Astro.props;

// Rota base do catálogo configurada no site.config.ts (ex: "catalogo", "imoveis", "produtos")
const catalogBase = siteConfig.routes.catalogSlug || 'catalogo';
const productDetailUrl = `/${catalogBase}/${produto.slug}`;

// WhatsApp Deep Link direto para o produto
const whatsappText = encodeURIComponent(`Olá! Vim pelo site e gostaria de informações sobre: ${produto.nome}`);
const whatsappUrl = `https://wa.me/${siteConfig.contact.whatsapp}?text=${whatsappText}`;
---

<div class="group relative flex flex-col bg-slate-900/60 rounded-2xl border border-slate-800/80 overflow-hidden hover:border-indigo-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-indigo-500/10">
  <!-- Imagem do Produto -->
  <div class="relative aspect-video w-full overflow-hidden bg-slate-950">
    <img
      src={produto.imagemPrincipal}
      alt={produto.nome}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <!-- Badge de Categoria -->
    <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-semibold bg-slate-950/80 backdrop-blur-md text-indigo-300 border border-slate-800">
      {produto.categoria}
    </span>
    {produto.destaque && (
      <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-400 text-slate-950 shadow-md">
        ★ Destaque
      </span>
    )}
  </div>

  <!-- Conteúdo do Card -->
  <div class="flex flex-col flex-1 p-6">
    <div class="flex-1">
      <h3 class="text-lg font-bold font-display text-white group-hover:text-indigo-300 transition-colors">
        <a href={productDetailUrl}>
          {produto.nome}
        </a>
      </h3>
      {produto.resumo && (
        <p class="mt-2 text-sm text-slate-400 line-clamp-2 leading-relaxed">
          {produto.resumo}
        </p>
      )}
    </div>

    <!-- Rodapé do Card com Preço e Ações -->
    <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between gap-3">
      <div>
        <span class="text-[11px] uppercase font-semibold text-slate-400 block">Valor</span>
        <span class="text-sm font-bold text-white">
          {produto.preco || 'Sob Consulta'}
        </span>
      </div>

      <div class="flex items-center gap-2">
        <Button href={productDetailUrl} variant="outline" size="sm">
          Ver Detalhes
        </Button>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500 hover:text-white transition-all border border-emerald-500/20"
          title="Falar no WhatsApp"
          aria-label="Falar no WhatsApp"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-5.805 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
