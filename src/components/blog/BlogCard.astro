---
import type { Post } from '@/types';
import { siteConfig } from '@/config/site.config';

interface Props {
  post: Post;
}

const { post } = Astro.props;

// Rota base do blog configurada no site.config.ts (ex: "artigos", "blog", "noticias")
const blogBase = siteConfig.routes.blogSlug || 'artigos';
const postUrl = `/${blogBase}/${post.slug}`;

// Formatar data em português
const formattedDate = new Date(post.publicadoEm).toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric'
});
---

<article class="group flex flex-col bg-slate-900/60 rounded-2xl border border-slate-800/80 overflow-hidden hover:border-indigo-500/50 transition-all duration-300 hover:shadow-xl hover:shadow-indigo-500/10">
  <!-- Imagem de Capa -->
  <a href={postUrl} class="relative aspect-video w-full overflow-hidden bg-slate-950 block">
    <img
      src={post.imagemCapa}
      alt={post.titulo}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-semibold bg-slate-950/80 backdrop-blur-md text-indigo-300 border border-slate-800">
      {post.categoria}
    </span>
  </a>

  <!-- Conteúdo do Post -->
  <div class="flex flex-col flex-1 p-6">
    <!-- Metadados (Tempo & Data) -->
    <div class="flex items-center gap-3 text-xs text-slate-400 mb-3 font-medium">
      <span>{formattedDate}</span>
      <span>•</span>
      <span>{post.tempoLeitura} de leitura</span>
    </div>

    <!-- Título -->
    <h3 class="text-xl font-bold font-display text-white group-hover:text-indigo-300 transition-colors leading-snug">
      <a href={postUrl}>
        {post.titulo}
      </a>
    </h3>

    <!-- Resumo -->
    <p class="mt-3 text-sm text-slate-400 line-clamp-3 leading-relaxed flex-1">
      {post.resumo}
    </p>

    <!-- Autor & Link de Leitura -->
    <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-indigo-600 to-amber-400 flex items-center justify-center text-[10px] font-bold text-white font-display">
          {post.autorNome.charAt(0)}
        </div>
        <span class="text-xs font-semibold text-slate-300">
          {post.autorNome}
        </span>
      </div>

      <a
        href={postUrl}
        class="text-xs font-bold text-indigo-400 group-hover:text-indigo-300 inline-flex items-center gap-1 transition-colors"
      >
        Ler Artigo
        <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</article>
