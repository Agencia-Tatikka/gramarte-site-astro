---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import { getPosts } from '@/db/schema';
import { siteConfig } from '@/config/site.config';
import type { Post } from '@/types';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const blogBase = siteConfig.routes.blogSlug || 'artigos';
const currentUrl = `${siteConfig.url}/${blogBase}/${post.slug}`;

const formattedDate = new Date(post.publicadoEm).toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
});

// Schema JSON-LD para Google Rich Snippets (BlogPosting)
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.titulo,
  "description": post.resumo,
  "image": [post.imagemCapa],
  "datePublished": post.publicadoEm,
  "dateModified": post.atualizadoEm || post.publicadoEm,
  "author": {
    "@type": "Person",
    "name": post.autorNome,
    "jobTitle": post.autorCargo || "Colunista Especialista"
  },
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.name,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteConfig.url}/favicon.svg`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": currentUrl
  }
};
---

<BaseLayout
  title={`${post.titulo} | Blog ${siteConfig.name}`}
  description={post.resumo}
  ogImage={post.imagemCapa}
>
  <!-- Microdados Google Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />

  <main class="pt-24 pb-20">
    <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 py-6">
        <a href="/" class="hover:text-white transition-colors">Início</a>
        <span>/</span>
        <a href={`/${blogBase}`} class="hover:text-white transition-colors">Blog</a>
        <span>/</span>
        <span class="text-indigo-400 line-clamp-1">{post.titulo}</span>
      </nav>

      <!-- Cabeçalho do Artigo -->
      <header class="space-y-6 pb-8 border-b border-slate-800">
        <span class="inline-block px-3.5 py-1.5 rounded-full text-xs font-bold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
          {post.categoria}
        </span>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-white tracking-tight leading-tight">
          {post.titulo}
        </h1>

        <p class="text-lg sm:text-xl text-slate-300 leading-relaxed font-normal">
          {post.resumo}
        </p>

        <!-- Informações do Autor e Metadados -->
        <div class="flex flex-wrap items-center justify-between gap-4 pt-4 text-xs text-slate-400">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-indigo-600 to-amber-400 flex items-center justify-center text-sm font-bold text-white font-display">
              {post.autorNome.charAt(0)}
            </div>
            <div>
              <span class="font-bold text-white text-sm block">{post.autorNome}</span>
              <span>{post.autorCargo || 'Especialista'}</span>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <span>Publicado em {formattedDate}</span>
            <span>•</span>
            <span>{post.tempoLeitura} de leitura</span>
          </div>
        </div>
      </header>

      <!-- Imagem de Destaque -->
      <div class="my-8 aspect-video w-full rounded-3xl overflow-hidden bg-slate-900 border border-slate-800 shadow-2xl">
        <img
          src={post.imagemCapa}
          alt={post.titulo}
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Conteúdo do Artigo (HTML) -->
      <div class="prose prose-invert prose-indigo max-w-none text-slate-300 leading-relaxed text-base sm:text-lg space-y-6">
        <div set:html={post.conteudoHtml} />
      </div>

      <!-- Tags do Artigo -->
      {post.tags && post.tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-slate-800 flex flex-wrap items-center gap-2">
          <span class="text-xs font-semibold text-slate-400 mr-2">Tags:</span>
          {post.tags.map(tag => (
            <span class="px-3 py-1 rounded-lg text-xs bg-slate-900 border border-slate-800 text-slate-300 font-medium">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <!-- Bloco de CTA no Final do Post -->
      <div class="mt-16 p-8 rounded-3xl bg-gradient-to-br from-indigo-950/40 via-slate-900 to-slate-950 border border-indigo-500/20 text-center space-y-4">
        <h3 class="text-2xl font-bold font-display text-white">Gostou deste artigo?</h3>
        <p class="text-slate-400 text-sm max-w-xl mx-auto">
          Nossos consultores estão à disposição para ajudar a sua empresa a implementar essas melhorias com precisão técnica.
        </p>
        <div class="pt-2">
          <Button
            href={`https://wa.me/${siteConfig.contact.whatsapp}?text=${encodeURIComponent(`Olá! Li o artigo "${post.titulo}" e gostaria de conversar.`)}`}
            variant="primary"
            size="md"
            target="_blank"
          >
            Falar com Especialista no WhatsApp
          </Button>
        </div>
      </div>
    </article>
  </main>
</BaseLayout>
